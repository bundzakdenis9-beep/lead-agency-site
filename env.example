# Адрес, куда форма отправляет заявку (POST JSON).
# Оставьте пустым — форма работает в демо-режиме и ничего не отправляет.
# Для встроенной функции Vercel укажите: /api/lead
VITE_LEAD_ENDPOINT=

# Только для api/lead.js (серверная функция Vercel). Не добавляйте префикс VITE_ —
# токен не должен попадать в браузер.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
